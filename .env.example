# Everything is optional in development. Without email keys, sign-in links are
# printed to the server log and reminders are prepared for you to send yourself.

# Public URL used in payment links and sign-in emails.
PUBLIC_BASE_URL=http://localhost:4310

# Protects POST /api/cron/run. Send it as "Authorization: Bearer <secret>". The route refuses to run without it.
CRON_SECRET=

# Email via Resend: sign-in links, and reminders when a business turns on automatic sending.
# Reminders go out as "<Business> via Recoup <EMAIL_FROM>" with replies to the business.
RESEND_API_KEY=
EMAIL_FROM=reminders@mail.yourdomain.com
AUTH_EMAIL_FROM=signin@mail.yourdomain.com
# Signing secret of the Resend webhook pointed at /api/webhooks/resend (bounces, complaints).
RESEND_WEBHOOK_SECRET=
# Automatic emails per business per day.
EMAIL_DAILY_CAP=200

# QuickBooks Online (read-only invoice sync). Create an app at developer.intuit.com and register
# <PUBLIC_BASE_URL>/api/quickbooks/callback as its redirect URI and /api/quickbooks/disconnected as its disconnect URL.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
# Encrypts stored QuickBooks tokens. 32 random bytes, base64: `openssl rand -base64 32`. Don't change it once set.
TOKEN_ENCRYPTION_KEY=

# AI features
ANTHROPIC_API_KEY=

# Where accounts.db and each business's database (tenants/<id>.db) live.
DATA_DIR=./data
