# Everything is optional. With nothing set, Recoup runs in demo mode:
# texts and emails land in the in-app Outbox and payment links open a test pay page.

# Public URL used in payment links and for verifying Twilio webhooks.
PUBLIC_BASE_URL=http://localhost:4310

# Protects POST /api/cron/run. Send it as "Authorization: Bearer <secret>".
CRON_SECRET=

# SMS via Twilio (needs a 10DLC-registered number or messaging service for US traffic)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Email via Resend
RESEND_API_KEY=
EMAIL_FROM=billing@yourdomain.com

# Payments via Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Force demo controls on (1) or off (0). By default they show when SMS and email are both mocked.
DEMO_MODE=

# Where the SQLite database lives
DATABASE_PATH=./data/recoup-v2.db
